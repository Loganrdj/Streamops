# Copy to .env and fill in. Never commit .env.

# Twitch developer application (https://dev.twitch.tv/console/apps)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Numeric broadcaster (user) ID of the channel to watch
TWITCH_BROADCASTER_ID=

# URL from the "Ingest Twitch sync payload" automation's webhook trigger.
# Treat it like a password: anyone with it can trigger the automation.
AIRTABLE_WEBHOOK_URL=
# Shared value the automation checks before writing (Airtable webhooks have no signature verification)
STREAMOPS_SHARED_TOKEN=

# Poll every 5 minutes by default. Faster polling = better estimates, more Twitch API calls.
POLL_INTERVAL_SECONDS=300
# Where viewer samples are kept between polls (outside Airtable, to protect the 1,000-record Free limit)
SAMPLES_DIR=./data/samples
