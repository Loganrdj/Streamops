{
  "name": "streamops-integrations",
  "version": "0.1.0",
  "private": true,
  "description": "Thin Twitch fetcher for StreamOps. Polls viewer counts locally and sends one summarized payload per stream to an Airtable webhook automation.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "poll": "tsx src/jobs/pollLiveStream.ts",
    "send-sample": "tsx src/jobs/sendSamplePayload.ts"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
