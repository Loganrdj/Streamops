# Leave both empty to run on the bundled demo snapshot.
# Personal access token from https://airtable.com/create/tokens
# Scopes: data.records:read only. Access: the StreamOps base only.
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=appk1TDkLadEimZ98

# How long live data is cached, in seconds. One refresh = 4 API requests.
REVALIDATE_SECONDS=900

NEXT_PUBLIC_DISPLAY_TIMEZONE=America/Los_Angeles
